# Microsoft Graph API - App Registration Credentials
# Register at: https://portal.azure.com > App Registrations > New registration
# Required permissions: Files.ReadWrite.All (Application)
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Excel File ID (from the SharePoint/OneDrive URL)
# Example: https://uceedu-my.sharepoint.com/personal/.../_layouts/15/doc.aspx?sourcedoc={FILE_ID}&...
EXCEL_FILE_ID=your_excel_file_id_here
EXCEL_WORKSHEET_NAME=Sheet1
EXCEL_TABLE_NAME=Table1
